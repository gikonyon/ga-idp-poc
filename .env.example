# Copy this file to .env and fill in real values for a real deployment.
# Never commit an actual .env file with real credentials to git.

# --- Security ---
GA_IDP_API_KEY=replace-with-a-strong-generated-key
GA_IDP_REQUIRE_AUTH=true

# --- Validation ---
GA_IDP_CONFIDENCE_THRESHOLD=0.95

# --- Storage ---
GA_IDP_DB_PATH=ga_idp.db

# --- Core system endpoints (Tier 4 connectors) ---
SAP_PO_ENDPOINT=https://sap-po.ga-insurance.internal/odata
ORACLE_OIC_ENDPOINT=https://oic.ga-insurance.internal/rest
CLOUD_WAREHOUSE_ENDPOINT=https://warehouse.ga-insurance.internal
